# FormFlow Environment Variables
# Copy this file to .env (backend) or .env.local (frontend)
# Never commit real secrets

# ── Backend (.env) ──────────────────────────────
# SQLite database path
DATABASE_URL=sqlite:///./dev.db

# Shared proxy authentication secret (must match frontend)
PROXY_SECRET=change-me-to-a-random-64-char-hex-string

# Comma-separated allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000

# Deployment environment: development | production
ENVIRONMENT=development

# Session lifetime in hours
SESSION_EXPIRY_HOURS=24

# ── Frontend (.env.local) ───────────────────────
# FastAPI backend URL (server-only, never NEXT_PUBLIC_)
BACKEND_URL=http://localhost:8000

# Shared proxy authentication secret (must match backend)
# PROXY_SECRET=change-me-to-a-random-64-char-hex-string
